{
  "name": "threadbeacon",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "threadbeacon": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "smoke:reddit": "tsx scripts/smoke-reddit.ts",
    "xhs:login": "tsx scripts/xhs-login.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker.ts",
    "gateway": "tsx src/gateway.ts",
    "control:dev": "pnpm --dir apps/control-plane dev",
    "control:build": "pnpm --dir apps/control-plane build",
    "control:java:check": "node scripts/java-control.mjs test",
    "control:lint": "pnpm --dir apps/control-plane lint",
    "check": "pnpm typecheck && pnpm test && pnpm control:java:check && pnpm control:lint && pnpm control:build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@jackwener/opencli": "1.8.5",
    "density-clustering": "^1.3.0",
    "fast-xml-parser": "^5.11.1",
    "ml-distance": "^4.0.1",
    "openai": "^6.17.0",
    "undici": "^7.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.13.1"
}
