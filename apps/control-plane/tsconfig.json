{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "vite.web.config.ts"
  ],
  "exclude": ["node_modules", "dist-web"]
}
